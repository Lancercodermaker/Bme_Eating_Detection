      "max_extra_per_hour": 16,
      "effective_recording_cap": "min(24, max(1, ceil(recording_span_hours * 16)))",
      "over_cap_action": "rank and truncate P_extra only; never truncate P_A",
      "cross_recording_budget": "none; each recording applies its own deterministic cap"
    },
    "provenance": [
