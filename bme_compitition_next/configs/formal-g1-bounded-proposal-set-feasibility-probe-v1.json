      "source": "outer-train model scores only; no outer-valid labels or event identities; not a final event threshold and not a threshold compensation",
      "no_fit": true
    },
    "active_support": "A window is active iff its score is greater than or equal to the fold support threshold.",
    "segment_rule": "Within one recording only, begin a new segment when local window indices are not consecutive, when the next start is after the previous end, or when either adjacent window is marked crosses_hard_gap. A hard-gap window is isolated. No session, recording, segment, or raw gap is crossed.",
    "support_region_rule": "A support region is a maximal run of active windows inside one gap-safe segment, with at least 2 active windows. Inactive windows terminate a region.",
    "boundary_variants": {
      "count_per_region": 3,
      "variants": [
        "support_core = [first_active.start, last_active.end)",
        "peak_window = the full window interval of the highest-score active window; ties use earliest local index",
        "boundary_expanded = support_core expanded by one 7.5s stride on both sides and clipped to the containing gap-safe segment"
      ],
      "variant_deduplication": "Exact (recording, start_ms, end_ms) duplicates merge provenance only; overlapping but non-identical intervals remain.",
      "ranking_for_extra_only_cap": "(-support_max, -support_mean, boundary_variant_name lexicographically, start_ms, end_ms)",
      "baseline_intervals_in_ranking": false
    },
    "budgets": {
