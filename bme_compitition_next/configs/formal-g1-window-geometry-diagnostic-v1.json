    "grid_origin": "per recording: min(first valid ACC timestamp, first valid GYRO timestamp), exactly as regularize_imu",
    "grid_end": "per recording: max(last valid ACC timestamp, last valid GYRO timestamp), exactly as regularize_imu",
    "window_seconds": 15.0,
    "window_points": 150,
    "A_stride_seconds": 7.5,
    "A_step_points": 75,
    "B_stride_seconds": 3.0,
    "B_step_points": 30,
    "window_endpoint": "[start, start + 15000 ms), end_ms=round(start + 15000)",
    "valid_window": "coverage >= 0.8; longest invalid run <= floor(2.0*10)=20 points; no hard gap; no negative segment id; no crossing of multiple regularized segments",
    "positive_label": "overlap_fraction >= 0.5, where overlap is normalized by window duration",
    "ignore_label": "not positive and nearest event distance < 300000 ms",
    "negative_label": "nearest event distance >= 300000 ms",
    "event_association": "same frozen participant event intervals; a window is associated to an event when its half-open interval overlaps that event",
    "event_eligibility": "no re-selection; retain all 234 original eligible events"
  },
  "grid_comparison": {
    "paired_recording": "same raw recording and same fully regularized series for A and B",
    "common_start_definition": "same regularized grid timestamp emitted at indices divisible by lcm(75,30)=150",
    "A_only_start_definition": "A grid starts not present in B",
    "B_only_start_definition": "B grid starts not present in A",
    "interpretation": "the comparison includes density and start-position changes; pure density effect is not separately identified",
    "primary_metrics": [
