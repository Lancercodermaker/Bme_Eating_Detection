  "pipeline_semantics": {
    "preprocessing": "read approved raw ACC/GYRO TSV with the production parser; aggregate duplicate timestamps by NaN-safe mean; drop non-positive timestamps; regularize each stream independently; combine ACC/GYRO valid masks; do not read local event-only slices",
